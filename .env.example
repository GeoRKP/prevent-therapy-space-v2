# --- Google Calendar (σύστημα κρατήσεων) ---
# Δημιουργούνται μία φορά στο console.cloud.google.com — βλ. scripts/google-setup.mjs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Προαιρετικό: ο θεραπευτής συνδέει τον λογαριασμό του από το /admin → «Google
# Calendar» (αποθηκεύεται στη Neon). Το env είναι fallback / για τοπική ανάπτυξη:
# παράγεται με: npm run google:setup
GOOGLE_REFRESH_TOKEN=""
# Προαιρετικό: συγκεκριμένο ημερολόγιο (default: primary)
GOOGLE_CALENDAR_ID="primary"

# --- Ρυθμίσεις κρατήσεων (προαιρετικά overrides — defaults στο data/booking.js) ---
# BOOKING_DURATION_MINUTES=45
# BOOKING_MIN_NOTICE_HOURS=2
# BOOKING_MAX_ADVANCE_DAYS=30
# Έως πόσες ώρες πριν το ραντεβού επιτρέπεται online ακύρωση
# BOOKING_CANCEL_NOTICE_HOURS=2
# Προαιρετικό ξεχωριστό secret για τα links ακύρωσης (default: GOOGLE_CLIENT_SECRET)
# BOOKING_LINK_SECRET=""
# --- Email φόρμας επικοινωνίας (Resend) ---
RESEND_API_KEY=""
# Αποστολέας (ίδιο όνομα με το υπάρχον env var στο Vercel)
EMAIL_FROM="PREVENT Therapy Space <onboarding@resend.dev>"
# Παραλήπτης ΟΛΩΝ των ειδοποιήσεων του θεραπευτή: φόρμα επικοινωνίας, νέες
# κρατήσεις, ακυρώσεις. Στο Vercel πρέπει να είναι το email του ιατρείου.
CONTACT_EMAIL="konpatsakis@gmail.com"

# --- Admin (/admin) & ρυθμίσεις ---
# Κωδικός εισόδου του θεραπευτή στο /admin
ADMIN_PASSWORD=""
# Neon Postgres — ΜΟΝΟ ρυθμίσεις: κρατήσεων (prevent_booking_settings) και σύνδεση
# Google Calendar (prevent_google_auth). Τα ραντεβού μένουν αποκλειστικά στο Calendar.
DATABASE_URL=""

# Δημόσιο URL του site: μπαίνει σε sitemap, JSON-LD, links ακύρωσης στα emails.
# Τοπικά localhost· στο Vercel (production) ΠΑΝΤΑ https://www.preventtherapy.gr
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
